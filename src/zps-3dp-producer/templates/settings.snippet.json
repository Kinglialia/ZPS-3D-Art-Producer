{
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "600000",
    "BASH_MAX_TIMEOUT_MS": "3600000"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": ".claude/skills/zps-3dp-producer/scripts/.deps/venv/bin/python .claude/skills/zps-3dp-producer/scripts/producer.py next --session" }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": ".claude/skills/zps-3dp-producer/scripts/.deps/venv/bin/python .claude/skills/zps-3dp-producer/scripts/producer.py on-stop" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": ".claude/skills/zps-3dp-producer/scripts/.deps/venv/bin/python .claude/skills/zps-3dp-producer/scripts/producer.py on-main-stop" }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(.claude/skills/zps-3dp-producer/scripts/.deps/venv/bin/python .claude/skills/zps-3dp-producer/scripts/producer.py:*)",
      "Bash(<SKILL>/scripts/run_tool.py:*)",
      "Bash(<SKILL>/scripts/.deps/venv/bin/python <SKILL>/scripts/assemble.py:*)",
      "Bash(<BLENDER>:*)",
      "Bash(<SKILL>/agents/zps-3dp-step-texture/tools/.deps/venv/bin/python <SKILL>/scripts/meshy_call.py:*)",
      "Bash(codex exec:*)",
      "Edit(/production/**)",
      "Edit(/production-*/**)"
    ]
  }
}
